<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:gravity="center">

    <!-- Cabeçalho "Mariana" -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="48dp"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:text="@string/nome_sublinhado"
        android:gravity="center"/>

    <!-- Container principal para os itens -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <!-- Item Escritório -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escritório"
                android:textSize="24sp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <ImageView
                android:layout_width="330dp"
                android:layout_height="150dp"
                android:src="@drawable/Escritorio"
                android:contentDescription="Imagem do escritório"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <!-- Item Sala de estar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sala de estar"
                android:textSize="24sp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <ImageView
                android:layout_width="330dp"
                android:layout_height="150dp"
                android:src="@drawable/SalaDeEstar"
                android:contentDescription="Imagem da sala de estar"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <!-- Item Quintal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quintal"
                android:textSize="24sp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <ImageView
                android:layout_width="330dp"
                android:layout_height="150dp"
                android:src="@drawable/Quintal"
                android:contentDescription="Imagem do quintal"
                android:scaleType="centerCrop"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>